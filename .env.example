# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://cdhvdhjronhfrkitfmop.supabase.co

# Project Settings -> API -> anon / publishable key (empieza con "sb_publishable_" o es el JWT anon legacy)
# NUNCA uses aqui la service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role key (secreta). Solo se usa server-side
# (Server Actions) para administrar usuarios de Supabase Auth desde el panel admin.
# NUNCA con prefijo NEXT_PUBLIC_, nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=
